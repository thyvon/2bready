# Copy to .env.production on the target server and fill in real values.
# Never commit the filled-in .env.production — secrets only live on the server.

# Generate with: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# Public hostname the app is served behind (Cloudflare Tunnel terminates TLS).
APP_URL=https://2bready.systemsolution.online
SANCTUM_STATEFUL_DOMAINS=2bready.systemsolution.online

# Database
DB_DATABASE=2bready
DB_USERNAME=2bready
DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# Frontend build args (baked in at `docker build` time — see 2bready-web/Dockerfile).
# Bare origin only, no /api suffix — src/lib/api.ts already appends /api/v1 itself.
NEXT_PUBLIC_API_URL=https://2bready.systemsolution.online
NEXT_PUBLIC_APP_NAME=2bReady
# Optional — defaults to "2bReady TP Portal" if unset (see docker-compose.prod.yml).
# NEXT_PUBLIC_TP_APP_NAME=2bReady TP Portal

# Host port the nginx container binds (Server 1's aaPanel already owns 80/443).
NGINX_PORT=8082

# File storage — defaults to Laravel's local disk (no S3 needed until Sprint 5 / documents).
# FILESYSTEM_DISK=local

# Broadcast — defaults to 'log' (no-op) since no Reverb/websocket service runs in this
# compose stack yet. Real-time features are not in scope until later sprints.
# BROADCAST_CONNECTION=log
