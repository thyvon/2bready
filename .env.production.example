# Copy to .env.production on the target server and fill in real values.
# Never commit the filled-in .env.production — secrets only live on the server.
#
# Quick start:
#   cp .env.production.example .env.production
#   nano .env.production          # fill in real values
#   make prod                     # build and start everything

# ============================================
# APP
# ============================================

# Generate with: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# Public hostname (Cloudflare Tunnel terminates TLS)
APP_URL=https://2bready.systemsolution.online
SANCTUM_STATEFUL_DOMAINS=2bready.systemsolution.online

# Frontend URLs — used by API for email links, Google OAuth redirects, etc.
# Must point at the real frontend paths, not the API itself.
FRONTEND_URL=https://2bready.systemsolution.online/portal
ADMIN_FRONTEND_URL=https://2bready.systemsolution.online/admin

# ============================================
# DATABASE
# ============================================

DB_DATABASE=2bready
DB_USERNAME=2bready
DB_PASSWORD=

# ============================================
# REDIS
# ============================================

REDIS_PASSWORD=

# ============================================
# PRODUCTION SETTINGS
# ============================================

# Logging — logs go to Docker's log driver (stderr), not files
LOG_LEVEL=warning

# Session cookie security — true behind HTTPS/Cloudflare
SESSION_SECURE_COOKIE=true

# ============================================
# FRONTEND (baked in at docker build time)
# ============================================

# Bare origin only, no /api suffix — src/lib/api.ts appends /api/v1 itself.
NEXT_PUBLIC_API_URL=https://2bready.systemsolution.online
NEXT_PUBLIC_APP_NAME=2bReady
# Optional — defaults to "2bReady TP Portal" if unset
# NEXT_PUBLIC_TP_APP_NAME=2bReady TP Portal

# ============================================
# CLOUDFLARE TUNNEL (REQUIRED)
# ============================================

# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels
# Then paste the token here. This replaces direct port exposure on nginx.
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================
# OPTIONAL (defaults shown)
# ============================================

# Host port for nginx (only needed if NOT using Cloudflare Tunnel)
# NGINX_PORT=8082

# File storage — defaults to Laravel's local disk
# FILESYSTEM_DISK=local

# Broadcast — defaults to 'log' (no-op, no websocket service)
# BROADCAST_CONNECTION=log

# Chrome HTML→PDF service (docker-compose gotenberg service)
GOTENBERG_URL=http://gotenberg:3000

# S3-compatible storage (only if FILESYSTEM_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=
