{
  "name": "2bready-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w admin-portal",
    "build:admin": "npm run build -w admin-portal",
    "lint:admin": "npm run lint -w admin-portal",
    "type-check:admin": "npm run type-check -w admin-portal",
    "dev:client": "npm run dev -w client-portal",
    "build:client": "npm run build -w client-portal",
    "lint:client": "npm run lint -w client-portal",
    "type-check:client": "npm run type-check -w client-portal",
    "dev:marketing": "npm run dev -w marketing",
    "build:marketing": "npm run build -w marketing",
    "lint:marketing": "npm run lint -w marketing",
    "type-check:marketing": "npm run type-check -w marketing",
    "dev:tp": "npm run dev -w tp-portal",
    "build:tp": "npm run build -w tp-portal",
    "lint:tp": "npm run lint -w tp-portal",
    "type-check:tp": "npm run type-check -w tp-portal",
    "generate:types": "npm run generate:types -w @2bready/api-client"
  }
}
